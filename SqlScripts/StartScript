-- 7. Tabela de Permissões (Cadastra telas e ações do sistema)
CREATE TABLE dbo.T_PERMISSAO (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    CHAVE VARCHAR(100) NOT NULL UNIQUE, -- Ex: 'CLIENTES_CRIAR', 'FUNCIONARIOS_DELETAR'
    NOME VARCHAR(100) NOT NULL,        -- Ex: 'Criar Clientes'
    MODULO VARCHAR(50) NOT NULL,         -- Ex: 'CLIENTES', 'FUNCIONARIOS'
    DESCRICAO VARCHAR(200) NULL
);
GO

-- 8. Tabela Intermediária (Relacionamento N:N entre Perfil e Permissão)
CREATE TABLE dbo.T_PERFIL_PERMISSAO (
    PERFIL_ID INT NOT NULL,
    PERMISSAO_ID INT NOT NULL,
    CONSTRAINT PK_PERFIL_PERMISSAO PRIMARY KEY (PERFIL_ID, PERMISSAO_ID),
    CONSTRAINT FK_PP_PERFIL FOREIGN KEY (PERFIL_ID) REFERENCES dbo.T_PERFIL(ID) ON DELETE CASCADE,
    CONSTRAINT FK_PP_PERMISSAO FOREIGN KEY (PERMISSAO_ID) REFERENCES dbo.T_PERMISSAO(ID) ON DELETE CASCADE
);
GO

