-- 1. Criação do Banco de Dados
CREATE DATABASE SistemaTMS;
GO

USE SistemaTMS;
GO

-- 2. Tabela de Perfis
CREATE TABLE dbo.T_PERFIL (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    NOME VARCHAR(50) NOT NULL UNIQUE,
    DESCRICAO VARCHAR(150) NULL
);
GO

