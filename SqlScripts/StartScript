GO

-- 3. Tabela de Funcionários / Usuários
CREATE TABLE dbo.T_FUNCIONARIO (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    NOME VARCHAR(150) NOT NULL,
    UNIDADE VARCHAR(100) NOT NULL,
    CPF VARCHAR(11) NOT NULL UNIQUE, 
    LOGIN VARCHAR(50) NOT NULL UNIQUE,
    SENHA VARCHAR(255) NOT NULL,
    PERFIL INT NOT NULL,
    CRIADO DATETIME2 NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_FUNCIONARIO_PERFIL FOREIGN KEY (PERFIL) REFERENCES dbo.T_PERFIL(ID)
);
GO

-- 4. Tabela de Clientes
CREATE TABLE dbo.T_CLIENTE (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    CPFCNPJ VARCHAR(14) NOT NULL UNIQUE, 
    NOME VARCHAR(150) NOT NULL,
    UNIDADE VARCHAR(100) NOT NULL,
    CRIADO DATETIME2 NOT NULL DEFAULT GETDATE(),
    ATUALIZADO DATETIME2 NULL
);
GO

-- 5. Tabela de Auditoria (Logs)
CREATE TABLE dbo.T_LOGS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    USUARIOID INT NULL,
    ACAO VARCHAR(10) NOT NULL CONSTRAINT CHK_Acao CHECK (ACAO IN ('INSERT', 'UPDATE', 'DELETE')),
    TABELA VARCHAR(50) NOT NULL,
    REGISTROID INT NOT NULL,
    DATAHORA DATETIME2 NOT NULL DEFAULT GETDATE(),
    DETALHES NVARCHAR(MAX) NULL,
    CONSTRAINT FK_AuditLogs_Funcionarios FOREIGN KEY (USUARIOID) REFERENCES dbo.T_FUNCIONARIO(ID) ON DELETE SET NULL
);
GO

